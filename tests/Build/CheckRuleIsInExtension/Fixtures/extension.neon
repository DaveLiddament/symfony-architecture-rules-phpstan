services:
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Tests\Build\CheckRuleIsInExtension\Fixtures\RegisteredRule
        tags:
            - phpstan.rules.rule
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Tests\Build\CheckRuleIsInExtension\Fixtures\ConditionallyRegisteredRule
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Tests\Build\CheckRuleIsInExtension\Fixtures\UntaggedRule

conditionalTags:
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Tests\Build\CheckRuleIsInExtension\Fixtures\ConditionallyRegisteredRule:
        phpstan.rules.rule: %someParameter%
