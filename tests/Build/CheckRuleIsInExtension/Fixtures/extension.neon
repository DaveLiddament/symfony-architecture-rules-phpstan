services:
    -
        class: DaveLiddament\PhpstanArchitectureRules\Tests\Build\CheckRuleIsInExtension\Fixtures\RegisteredRule
        tags:
            - phpstan.rules.rule
    -
        class: DaveLiddament\PhpstanArchitectureRules\Tests\Build\CheckRuleIsInExtension\Fixtures\ConditionallyRegisteredRule
    -
        class: DaveLiddament\PhpstanArchitectureRules\Tests\Build\CheckRuleIsInExtension\Fixtures\UntaggedRule

conditionalTags:
    DaveLiddament\PhpstanArchitectureRules\Tests\Build\CheckRuleIsInExtension\Fixtures\ConditionallyRegisteredRule:
        phpstan.rules.rule: %someParameter%
