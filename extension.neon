parameters:
    architecture:
        # The namespace your application code lives in.
        appNamespace: 'App'
        # Code in these namespaces is ignored by the architecture rules.
        ignoredNamespaces:
            - 'App\Tests'
        # Public #[Controller] methods must return one of these (or a subclass), or a union of them.
        controllerReturnTypes:
            - 'Symfony\Component\HttpFoundation\Response'
        boundaries:
            # Set to false to turn off all the architectural boundary rules.
            enabled: true
            # Set any of these to null to turn off the rule that guards it.
            libNamespace: 'Lib'
            sharedNamespace: 'App\Shared'
            nurseryNamespace: 'App\Nursery'
        roles:
            # Set any of these to false to turn off all the rules for that role.
            cliCommand: true
            configProvider: true
            controller: true
            dto: true
            queueProcessor: true
            repository: true
            serializer: true
            service: true
            valueObject: true
            viewModel: true
        roleRequired:
            # Set to false to stop requiring every application class to declare a role.
            enabled: true
            # Classes that may stay roleless, e.g. framework glue outside the app root.
            exemptClasses: []

parametersSchema:
    architecture: structure([
        appNamespace: string()
        ignoredNamespaces: listOf(string())
        controllerReturnTypes: listOf(string())
        boundaries: structure([
            enabled: bool()
            libNamespace: schema(string(), nullable())
            sharedNamespace: schema(string(), nullable())
            nurseryNamespace: schema(string(), nullable())
        ])
        roles: structure([
            cliCommand: bool()
            configProvider: bool()
            controller: bool()
            dto: bool()
            queueProcessor: bool()
            repository: bool()
            serializer: bool()
            service: bool()
            valueObject: bool()
            viewModel: bool()
        ])
        roleRequired: structure([
            enabled: bool()
            exemptClasses: listOf(string())
        ])
    ])

services:
    -
        class: DaveLiddament\PhpstanArchitectureRules\Boundaries\BoundaryClassifier
        arguments:
            appNamespace: %architecture.appNamespace%
            libNamespace: %architecture.boundaries.libNamespace%
            sharedNamespace: %architecture.boundaries.sharedNamespace%
            nurseryNamespace: %architecture.boundaries.nurseryNamespace%
            ignoredNamespaces: %architecture.ignoredNamespaces%

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\LibIsolationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\SharedIsolationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\DomainInternalRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\NurseryIsolationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\RoleLocationRule
        arguments:
            entityAttribute: 'Doctrine\ORM\Mapping\Entity'

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\CliCommandDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\DtoDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\QueueProcessorDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\SerializerDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ServiceDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ValueObjectDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ViewModelDeclarationRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ValueObjectPropertyTypeRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ViewModelPropertyTypeRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderPropertyTypeRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderUsageRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ServiceDependencyRule
        arguments:
            appNamespace: %architecture.appNamespace%

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryDependencyRule
        arguments:
            doctrineNamespace: 'Doctrine'

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryMethodRule

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\EntityManagerUsageRule
        arguments:
            entityManagerInterface: 'Doctrine\ORM\EntityManagerInterface'

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ArrayShapeReturnRule
        arguments:
            ignoredNamespaces: %architecture.ignoredNamespaces%

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ControllerMethodReturnTypeRule
        arguments:
            allowedReturnTypes: %architecture.controllerReturnTypes%

    -
        class: DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RoleRequiredRule
        arguments:
            entityAttribute: 'Doctrine\ORM\Mapping\Entity'
            exemptClasses: %architecture.roleRequired.exemptClasses%

conditionalTags:
    DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\LibIsolationRule:
        phpstan.rules.rule: %architecture.boundaries.enabled%
    DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\SharedIsolationRule:
        phpstan.rules.rule: %architecture.boundaries.enabled%
    DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\DomainInternalRule:
        phpstan.rules.rule: %architecture.boundaries.enabled%
    DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\NurseryIsolationRule:
        phpstan.rules.rule: %architecture.boundaries.enabled%
    DaveLiddament\PhpstanArchitectureRules\Rules\Boundaries\RoleLocationRule:
        phpstan.rules.rule: %architecture.boundaries.enabled%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\CliCommandDeclarationRule:
        phpstan.rules.rule: %architecture.roles.cliCommand%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderDeclarationRule:
        phpstan.rules.rule: %architecture.roles.configProvider%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\DtoDeclarationRule:
        phpstan.rules.rule: %architecture.roles.dto%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\QueueProcessorDeclarationRule:
        phpstan.rules.rule: %architecture.roles.queueProcessor%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryDeclarationRule:
        phpstan.rules.rule: %architecture.roles.repository%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\SerializerDeclarationRule:
        phpstan.rules.rule: %architecture.roles.serializer%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ServiceDeclarationRule:
        phpstan.rules.rule: %architecture.roles.service%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ValueObjectDeclarationRule:
        phpstan.rules.rule: %architecture.roles.valueObject%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ViewModelDeclarationRule:
        phpstan.rules.rule: %architecture.roles.viewModel%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ValueObjectPropertyTypeRule:
        phpstan.rules.rule: %architecture.roles.valueObject%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ViewModelPropertyTypeRule:
        phpstan.rules.rule: %architecture.roles.viewModel%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderPropertyTypeRule:
        phpstan.rules.rule: %architecture.roles.configProvider%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ConfigProviderUsageRule:
        phpstan.rules.rule: %architecture.roles.configProvider%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ServiceDependencyRule:
        phpstan.rules.rule: %architecture.roles.service%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryDependencyRule:
        phpstan.rules.rule: %architecture.roles.repository%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RepositoryMethodRule:
        phpstan.rules.rule: %architecture.roles.repository%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\EntityManagerUsageRule:
        phpstan.rules.rule: %architecture.roles.repository%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ArrayShapeReturnRule:
        phpstan.rules.rule: %architecture.roles.serializer%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\ControllerMethodReturnTypeRule:
        phpstan.rules.rule: %architecture.roles.controller%
    DaveLiddament\PhpstanArchitectureRules\Rules\Roles\RoleRequiredRule:
        phpstan.rules.rule: %architecture.roleRequired.enabled%
