parameters:
    symfonyArchitecture:
        # The namespace your application code lives in.
        appNamespace: 'App'
        # Code in these namespaces is ignored by the architecture rules.
        ignoredNamespaces:
            - 'App\Tests'
        # Public #[Controller] methods must return one of these (or a subclass), or a union of them.
        controllerReturnTypes:
            - 'Symfony\Component\HttpFoundation\Response'
        boundaries:
            # Set to false to turn off all the architectural boundary rules.
            enabled: true
            # Set any of these to null to turn off the rule that guards it.
            libNamespace: 'Lib'
            sharedNamespace: 'App\Shared'
            nurseryNamespace: 'App\Nursery'
        roles:
            # Set any of these to false to turn off all the rules for that role.
            command: true
            configProvider: true
            controller: true
            dto: true
            formType: true
            queueProcessor: true
            repository: true
            serializer: true
            service: true
            valueObject: true
            viewModel: true

parametersSchema:
    symfonyArchitecture: structure([
        appNamespace: string()
        ignoredNamespaces: listOf(string())
        controllerReturnTypes: listOf(string())
        boundaries: structure([
            enabled: bool()
            libNamespace: schema(string(), nullable())
            sharedNamespace: schema(string(), nullable())
            nurseryNamespace: schema(string(), nullable())
        ])
        roles: structure([
            command: bool()
            configProvider: bool()
            controller: bool()
            dto: bool()
            formType: bool()
            queueProcessor: bool()
            repository: bool()
            serializer: bool()
            service: bool()
            valueObject: bool()
            viewModel: bool()
        ])
    ])

services:
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Boundaries\BoundaryClassifier
        arguments:
            appNamespace: %symfonyArchitecture.appNamespace%
            libNamespace: %symfonyArchitecture.boundaries.libNamespace%
            sharedNamespace: %symfonyArchitecture.boundaries.sharedNamespace%
            nurseryNamespace: %symfonyArchitecture.boundaries.nurseryNamespace%
            ignoredNamespaces: %symfonyArchitecture.ignoredNamespaces%

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\LibIsolationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\SharedIsolationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\DomainInternalRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\NurseryIsolationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\RoleLocationRule
        arguments:
            entityAttribute: 'Doctrine\ORM\Mapping\Entity'

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\CommandDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\DtoDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\FormTypeDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\QueueProcessorDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\SerializerDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ServiceDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ValueObjectDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ViewModelDeclarationRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ValueObjectPropertyTypeRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ViewModelPropertyTypeRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderPropertyTypeRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderUsageRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ServiceDependencyRule
        arguments:
            appNamespace: %symfonyArchitecture.appNamespace%

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryDependencyRule
        arguments:
            doctrineNamespace: 'Doctrine'

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryMethodRule

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\EntityManagerUsageRule
        arguments:
            entityManagerInterface: 'Doctrine\ORM\EntityManagerInterface'

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ArrayShapeReturnRule
        arguments:
            ignoredNamespaces: %symfonyArchitecture.ignoredNamespaces%

    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ControllerMethodReturnTypeRule
        arguments:
            allowedReturnTypes: %symfonyArchitecture.controllerReturnTypes%

conditionalTags:
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\LibIsolationRule:
        phpstan.rules.rule: %symfonyArchitecture.boundaries.enabled%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\SharedIsolationRule:
        phpstan.rules.rule: %symfonyArchitecture.boundaries.enabled%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\DomainInternalRule:
        phpstan.rules.rule: %symfonyArchitecture.boundaries.enabled%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\NurseryIsolationRule:
        phpstan.rules.rule: %symfonyArchitecture.boundaries.enabled%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Boundaries\RoleLocationRule:
        phpstan.rules.rule: %symfonyArchitecture.boundaries.enabled%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\CommandDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.command%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.configProvider%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\DtoDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.dto%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\FormTypeDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.formType%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\QueueProcessorDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.queueProcessor%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.repository%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\SerializerDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.serializer%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ServiceDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.service%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ValueObjectDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.valueObject%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ViewModelDeclarationRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.viewModel%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ValueObjectPropertyTypeRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.valueObject%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ViewModelPropertyTypeRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.viewModel%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderPropertyTypeRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.configProvider%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ConfigProviderUsageRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.configProvider%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ServiceDependencyRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.service%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryDependencyRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.repository%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\RepositoryMethodRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.repository%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\EntityManagerUsageRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.repository%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ArrayShapeReturnRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.serializer%
    DaveLiddament\SymfonyArchitectureRulesPhpstan\Rules\Roles\ControllerMethodReturnTypeRule:
        phpstan.rules.rule: %symfonyArchitecture.roles.controller%
