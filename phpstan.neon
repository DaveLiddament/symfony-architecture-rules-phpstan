parameters:
    level: max
    paths:
        - attributes
        - src
        - tests
        - build
    excludePaths:
        analyse:
            # Fixtures intentionally contain rule violations; they are
            # analysed by the rule test harness instead.
            - tests/*/Fixtures/*
    phpLanguageExtensions:
        mode: none
    checkUninitializedProperties: true
    checkMissingOverrideMethodAttribute: true
    rememberPossiblyImpureFunctionValues: false

services:
    # Internal check: every rule in this package is registered in extension.neon.
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Build\PHPStan\Rules\CheckRuleIsInExtension
        arguments:
            extensionFile: %currentWorkingDirectory%/extension.neon
            namespace: 'DaveLiddament\SymfonyArchitectureRulesPhpstan'
            excludedNamespaces:
                - 'DaveLiddament\SymfonyArchitectureRulesPhpstan\Build'
                - 'DaveLiddament\SymfonyArchitectureRulesPhpstan\Tests'
        tags:
            - phpstan.rules.rule

    # Internal check: every rule in this package has a test with fixtures.
    -
        class: DaveLiddament\SymfonyArchitectureRulesPhpstan\Build\PHPStan\Rules\CheckRuleHasTest
        arguments:
            ruleDirectories:
                - %currentWorkingDirectory%/src
                - %currentWorkingDirectory%/build
            testsDirectory: %currentWorkingDirectory%/tests
        tags:
            - phpstan.rules.rule

includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/dave-liddament/phpstan-php-language-extensions/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-dangerous-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-execution-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-insecure-calls.neon
    - vendor/spaze/phpstan-disallowed-calls/disallowed-loose-calls.neon
